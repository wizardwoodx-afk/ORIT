{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": { "includes": ["packages/**", "apps/**", "scripts/**", "!**/node_modules", "!**/*.css"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noNonNullAssertion": "off", "useImportType": "error" },
      "complexity": { "noForEach": "off" }
    }
  }
}
